# submit multiple simulations and harvest scaling and job information

executable = ./run_simulations.sh
arguments = $(SHELL) $(START) $(END) $(SCENARIO)

should_transfer_files = YES
transfer_input_files = $(SHELL), $(PYTHON_SIMULATION_SCRIPT)
transfer_output_files = $(PLATFORM_TEMPLATE)_$(SHELL)_$(START)_$(END).csv.tar.gz
transfer_output_remaps = "$(PLATFORM_TEMPLATE)_$(SHELL)_$(START)_$(END).csv.tar.gz = $(SCENARIO)/$(PLATFORM_TEMPLATE)_$(SHELL)_$(START)_$(END).csv.tar.gz"
when_to_transfer_output = ON_EXIT

log = $(SCENARIO)/logs/log.$(ClusterId).$(ProcId)
output = $(SCENARIO)/logs/out.$(ClusterId).$(ProcId)
error = $(SCENARIO)/logs/err.$(ClusterId).$(ProcId)

universe = docker
docker_image = registry.cern.ch/docker.io/mhorzela/dcsim:latest

# +MaxWalltime = 1800
+JobFlavour = "espresso"
request_cpus = 1
RequestMemory = 1500M
RequestDisk = 1G

x509userproxy = $ENV(X509_USER_PROXY)

PLATFORM_TEMPLATE = sgbatch_validation_template.xml
SCENARIO = fcfn
# WORKLOAD = crown_ttbar_slowjob.json
# DATASET = crown_ttbar_slowjob.json
# XROOTD_BLOCKSIZE = 10000000000
# STORAGE_BUFFER_SIZE = 0
# SEED = 42

SHELL = cloud-8.list
PYTHON_SIMULATION_SCRIPT = run_shell_simulations.py

queue START, END from (
<JOBS>
)
